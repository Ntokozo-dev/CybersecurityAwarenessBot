<Window x:Class="CybersecurityAwarenessChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessChatbotGUI"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" Height="700" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">

    <!-- One Grid divides the window into 5 horizontal rows. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: lblTitle -->
            <RowDefinition Height="Auto"/>
            <!-- 1: rtbBanner (ASCII art) -->
            <RowDefinition Height="*"/>
            <!-- 2: rtbChatHistory (fills the space left) -->
            <RowDefinition Height="Auto"/>
            <!-- 3: input bar -->
        </Grid.RowDefinitions>

        <!-- Row 0: Title -->
        <Label x:Name="lblTitle" Grid.Row="0"
               Content="Cybersecurity Awareness Chatbot"
               Foreground="Cyan" FontFamily="Consolas"
               FontSize="22" FontWeight="Bold"
               HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <!-- Row 1: ASCII banner. -->
        <Border Grid.Row="1" Margin="0,5,0,5" Padding="0,8"
        Background="#05080C" BorderBrush="Cyan"
        BorderThickness="0,1,0,1">
            <TextBlock x:Name="tbBanner"
               HorizontalAlignment="Center"
               FontFamily="Consolas" FontSize="15"
               Foreground="Cyan"/>
        </Border>

        <!-- Row 2: Conversation history -->
        <RichTextBox x:Name="rtbChatHistory" Grid.Row="2"
                     IsReadOnly="True" IsTabStop="False"
                     VerticalScrollBarVisibility="Auto"
                     Background="#05080C" Foreground="LightGreen"
                     FontFamily="Consolas" FontSize="14"
                     BorderBrush="#1F6F5C" BorderThickness="1"
                     Padding="6" Margin="10,5,10,5">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0,0,0,2"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Row 3: Input box and Send button side by side -->
        <Grid Grid.Row="4" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtUserInput" Grid.Column="0"
                     Background="#05080C" Foreground="LightGreen"
                     CaretBrush="LightGreen"
                     FontFamily="Consolas" FontSize="14"
                     BorderBrush="#1F6F5C" Padding="6"
                     VerticalContentAlignment="Center"/>

            <Button x:Name="btnSend" Grid.Column="1" Content="Send"
                    Width="90" Margin="8,0,0,0"
                    Background="#12303A" Foreground="Cyan"
                    BorderBrush="#1F6F5C"
                    FontFamily="Consolas" FontWeight="Bold"
                    IsDefault="True" Click="btnSend_Click"/>
        </Grid>

    </Grid>
</Window>