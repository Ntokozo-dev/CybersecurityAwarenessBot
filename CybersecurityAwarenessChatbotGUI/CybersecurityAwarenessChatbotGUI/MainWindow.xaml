<Window x:Class="CybersecurityAwarenessChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessChatbotGUI"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" Height="700" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">

    <TabControl Background="#0B0F14">

        <!-- TAB 1: chat interface -->
        <TabItem Header="Chat">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="lblTitle" Grid.Row="0"
                       Content="Cybersecurity Awareness Chatbot"
                       Foreground="Cyan" FontFamily="Consolas"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <Border Grid.Row="1" Margin="0,5,0,5" Padding="0,8"
                        Background="#05080C" BorderBrush="Cyan"
                        BorderThickness="0,1,0,1">
                    <TextBlock x:Name="tbBanner"
                               HorizontalAlignment="Center"
                               FontFamily="Consolas" FontSize="15"
                               Foreground="Cyan"/>
                </Border>

                <RichTextBox x:Name="rtbChatHistory" Grid.Row="2"
                             IsReadOnly="True" IsTabStop="False"
                             VerticalScrollBarVisibility="Auto"
                             Background="#05080C" Foreground="LightGreen"
                             FontFamily="Consolas" FontSize="14"
                             BorderBrush="#1F6F5C" BorderThickness="1"
                             Padding="6" Margin="10,5,10,5">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0,0,0,2"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>

                <Grid Grid.Row="3" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtUserInput" Grid.Column="0"
                             Background="#05080C" Foreground="LightGreen"
                             CaretBrush="LightGreen"
                             FontFamily="Consolas" FontSize="14"
                             BorderBrush="#1F6F5C" Padding="6"
                             VerticalContentAlignment="Center"/>

                    <Button x:Name="btnSend" Grid.Column="1" Content="Send"
                            Width="90" Margin="8,0,0,0"
                            Background="#12303A" Foreground="Cyan"
                            BorderBrush="#1F6F5C"
                            FontFamily="Consolas" FontWeight="Bold"
                            IsDefault="True" Click="btnSend_Click"/>
                </Grid>
            </Grid>
        </TabItem>

        <!-- TAB 2: Task Assistant -->
        <TabItem Header="Tasks">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- input fields -->
                    <RowDefinition Height="Auto"/>
                    <!-- Add button -->
                    <RowDefinition Height="*"/>
                    <!-- task list -->
                    <RowDefinition Height="Auto"/>
                    <!-- Complete/Delete buttons -->
                </Grid.RowDefinitions>

                <!-- Row 0: input fields for a new task -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Title:" Foreground="Cyan" FontFamily="Consolas"/>
                    <TextBox x:Name="txtTaskTitle" Background="#05080C" Foreground="LightGreen"
                     CaretBrush="LightGreen" FontFamily="Consolas" Padding="4" Margin="0,2,0,6"/>

                    <TextBlock Text="Description:" Foreground="Cyan" FontFamily="Consolas"/>
                    <TextBox x:Name="txtTaskDescription" Background="#05080C" Foreground="LightGreen"
                     CaretBrush="LightGreen" FontFamily="Consolas" Padding="4" Margin="0,2,0,6"/>

                    <TextBlock Text="Reminder (optional, e.g. 2026-10-15):" Foreground="Cyan" FontFamily="Consolas"/>
                    <TextBox x:Name="txtTaskReminder" Background="#05080C" Foreground="LightGreen"
                     CaretBrush="LightGreen" FontFamily="Consolas" Padding="4" Margin="0,2,0,6"/>
                </StackPanel>

                <!-- Row 1: Add Task button -->
                <Button x:Name="btnAddTask" Grid.Row="1" Content="Add Task"
                Background="#12303A" Foreground="Cyan" BorderBrush="#1F6F5C"
                FontFamily="Consolas" FontWeight="Bold" Padding="6"
                HorizontalAlignment="Left" Margin="0,0,0,10"
                Click="btnAddTask_Click"/>

                <!-- Row 2: list of existing tasks -->
                <ListBox x:Name="lstTasks" Grid.Row="2"
                 Background="#05080C" Foreground="LightGreen"
                 FontFamily="Consolas" BorderBrush="#1F6F5C"
                 Margin="0,0,0,10"/>

                <!-- Row 3: Complete / Delete buttons for the selected task -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button x:Name="btnCompleteTask" Content="Mark Complete"
                    Background="#12303A" Foreground="Cyan" BorderBrush="#1F6F5C"
                    FontFamily="Consolas" Padding="6" Margin="0,0,10,0"
                    Click="btnCompleteTask_Click"/>
                    <Button x:Name="btnDeleteTask" Content="Delete"
                    Background="#12303A" Foreground="Cyan" BorderBrush="#1F6F5C"
                    FontFamily="Consolas" Padding="6"
                    Click="btnDeleteTask_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- TAB 3: Quiz -->
        <TabItem Header="Quiz">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- question text -->
                    <RowDefinition Height="*"/>
                    <!-- answer options -->
                    <RowDefinition Height="Auto"/>
                    <!-- feedback text -->
                    <RowDefinition Height="Auto"/>
                    <!-- submit button -->
                </Grid.RowDefinitions>

                <TextBlock x:Name="tbQuizQuestion" Grid.Row="0"
                   Text="Question goes here" Foreground="Cyan"
                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                <!-- Options are added here dynamically from code, since the
             number of choices differs between MCQ (4) and True/False (2). -->
                <StackPanel x:Name="spQuizOptions" Grid.Row="1"/>

                <TextBlock x:Name="tbQuizFeedback" Grid.Row="2"
                   Foreground="Yellow" FontFamily="Consolas"
                   TextWrapping="Wrap" Margin="0,10,0,10"/>

                <Button x:Name="btnQuizSubmit" Grid.Row="3" Content="Submit Answer"
                Background="#12303A" Foreground="Cyan" BorderBrush="#1F6F5C"
                FontFamily="Consolas" FontWeight="Bold" Padding="6"
                HorizontalAlignment="Left" Click="btnQuizSubmit_Click"/>
            </Grid>
        </TabItem>


    </TabControl>
</Window>